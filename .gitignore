# Allowlist: only the public parts of the lab are tracked.
# Strategy code (research/, catalog/, bentley/, cayenne/), data, ledgers and host/server details stay local.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/arena/
!/results/
!/automation/
/arena/state/
/results/*
!/results/__init__.py
!/results/ledger.py
__pycache__/
*.pyc
.DS_Store
._*
.env*
*.sqlite
*.pkl
*.jsonl
